<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.procurement.reviewexpert.mapper.ReviewExpertMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="reviewExpertResultMap" type="org.springblade.procurement.reviewexpert.pojo.entity.ReviewExpert">
        <result column="id" property="id"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="expert_code" property="expertCode"/>
        <result column="expert_name" property="expertName"/>
        <result column="expert_source_type" property="expertSourceType"/>
        <result column="sex" property="sex"/>
        <result column="phone" property="phone"/>
        <result column="major_years" property="majorYears"/>
        <result column="professional_codes" property="professionalCodes"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="dept_code" property="deptCode"/>
        <result column="dept_name" property="deptName"/>
        <result column="department_code" property="departmentCode"/>
        <result column="department_name" property="departmentName"/>
        <result column="approval_status" property="approvalStatus"/>
        <result column="admission_description" property="admissionDescription"/>
        <result column="retirement_description" property="retirementDescription"/>
        <result column="dept_leader_by" property="deptLeaderBy"/>
        <result column="dept_leader_name" property="deptLeaderName"/>
        <result column="hr_approver_by" property="hrApproverBy"/>
        <result column="hr_approver_name" property="hrApproverName"/>
        <result column="enable_status" property="enableStatus"/>
        <result column="fields1" property="fields1"/>
        <result column="fields2" property="fields2"/>
        <result column="create_by" property="createBy"/>
        <result column="create_name" property="createName"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_name" property="updateName"/>
        <result column="remark" property="remark"/>
        <result column="tenant_code" property="tenantCode"/>
        <result column="del_flag" property="delFlag"/>
    </resultMap>


    <select id="selectReviewExpertPage" resultMap="reviewExpertResultMap">
        SELECT *
        FROM proc_review_expert
        WHERE del_flag = '0'
          AND tenant_code = #{reviewExpert.tenantCode}
    </select>

</mapper>

